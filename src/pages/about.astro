---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import { createMarkdownProcessor } from "@astrojs/markdown-remark"
import { readFile } from "node:fs/promises"
import { resolve } from "node:path"
import Layout from "../layouts/Layout.astro"

const source = await readFile(resolve(process.cwd(), "content/About.md"), "utf8")
const markdown = source
const imageModules = import.meta.glob<{ default: ImageMetadata }>("../../content/About/*.{jpg,jpeg,png}", { eager: true })
const processor = await createMarkdownProcessor({ syntaxHighlight: false })
const segments = await Promise.all(markdown.split(/(!\[[^\]]*\]\(About\/[^)]+\))/g).filter(Boolean).map(async (part) => {
  const image = /^!\[([^\]]*)\]\(About\/([^)]+)\)$/.exec(part)
  if (image) {
    const asset = imageModules[`../../content/About/${image[2]}`]?.default
    if (!asset) throw new Error(`Missing About image: ${image[2]}`)
    return { kind: "image" as const, asset, alt: image[1] || "David Campbell archive photograph" }
  }
  const rendered = await processor.render(part)
  return { kind: "html" as const, html: rendered.code }
}))
---

<Layout title="About" description="The life and work of David Campbell, 1931–2018." active="about">
  <article class="about-copy">
    {segments.map((segment, index) => segment.kind === "image" ? (
      <Image
        src={segment.asset}
        alt={segment.alt}
        class="mx-auto my-8 h-auto max-w-full"
        widths={[480, 760, 1200, 1600, 2048]}
        sizes="(min-width: 824px) 760px, calc(100vw - 3rem)"
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : undefined}
      />
    ) : (
      <Fragment set:html={segment.html} />
    ))}
  </article>
</Layout>
